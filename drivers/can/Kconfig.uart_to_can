module = CAN_UART_TO_CAN
module-str = can_uart_to_can

config CAN_UART_TO_CAN
    bool "Enable can_uart_to_can driver"
    default y
	depends on DT_HAS_POWERLABS_UART_TO_CAN_ENABLED
    select UART
    help
        Enable can_uart_to_can driver

config CAN_UART_TO_CAN_ASYNC_API
    bool "Use UART asynchronous API in can_uart_to_can"
    depends on UART_ASYNC_API
    help
      Use UART asynchronous API for can_uart_to_can.
      When disabled, can_uart_to_can uses UART interrupt-driven API.

config UART_TO_CAN_USE_SYS_WORK_Q
    bool "Uart to can to use ths system work queue"
    default y
    help 
        Should the work queue used by uart to can be the system q or a user defined work q. Useful for when a system that run on the work queue depends on the uart to can.
        If false, a function "struct k_work_q *uart_to_can_get_work_q(void)" needs to be defined to return a pointer to the work queue to be used. 

config CAN_UART_TO_CAN_RX_BUFFER_COUNT
    int "Number of uart_to_can_frame to be used"
    default 20
    help
      Number of uart_to_can_frame to be used. The total number of bytes is CAN_UART_TO_CAN_RX_BUFFER_COUNT * MAX_UART_CAN_FRAME.