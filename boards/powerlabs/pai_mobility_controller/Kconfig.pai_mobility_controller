config BOARD_PAI_MOBILITY_CONTROLLER
	select SOC_STM32G473XX
	# The TPL5010 resets the board unless DONE is pulsed, so every image
	# built for it needs the GPIO driver.
	select GPIO

config PAI_MOBILITY_SETUP_TPL5010_PRIORITY
	int "TPL5010 setup priority"
	default 5
	help
	  Priority used to setup TPL5010 watchdog chip.