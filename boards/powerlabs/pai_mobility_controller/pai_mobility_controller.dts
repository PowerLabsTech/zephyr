/dts-v1/;
#include <st/g4/stm32g473Xe.dtsi>
#include <st/g4/stm32g473v(b-c-e)hx-pinctrl.dtsi>

/ {
	model = "PAI Mobility Controller";
	compatible = "powerlabs,pai-mobility-controller";

	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		can-device = &fdcan3;
		watchdog0 = &iwdg;
		led0 = &led_red;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led_red {
			gpios = <&gpiod 15 GPIO_ACTIVE_LOW>;
			label = "LED Red";
		};

		led_blue: led_blue {
			gpios = <&gpiod 13 GPIO_ACTIVE_LOW>;
			label = "LED Blue";
		};

		led_green: led_green {
			gpios = <&gpiod 14 GPIO_ACTIVE_LOW>;
			label = "LED Green";
		};
	};

	tpl5010 {
		done_pin{
			compatible = "gpio-leds";
			status = "okay";
			tpl5010_done_pin: tpl5010_done_pin {
				gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>;
				label = "TPL5010 Done Pin";
			};
		};

		wake_pin {
			compatible = "gpio-keys";
			status = "okay";
			tpl5010_wake_pin: tpl5010_wake_pin {
				gpios = <&gpioc 14 GPIO_ACTIVE_HIGH>;
				label = "TPL5010 Wake Pin";
			};
		};
	};
};

&clk_lsi {
	status = "okay";
};

&clk_lse {
	status = "disabled";
};

&clk_hsi {
	status = "disabled";
};

&clk_hse {
	status = "okay";
	clock-frequency = <DT_FREQ_M(24)>;
};

/** PLLCLK is the core clock at 144MHz, shared by AHB and APB1. APB2 is halved:
 * SD card init needs 100-400 kHz and SPI1 can only divide PCLK2 by 256.
 */
&rcc {
	status = "okay";
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(144)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <2>;
};

/** Using the 24MHz external crystal, we can use the following PLL settings to
 * PLLCLK to 144MHz
 * PLLQ to 48MHz
 * PLLR to 144MHz
*/
&pll {
	status = "okay";
	div-m = <6>;
	mul-n = <72>;
	div-p = <2>;
	div-q = <6>;
	div-r = <2>;
	clocks = <&clk_hse>;
};

&rtc {
	status = "okay";
	clocks = <&rcc STM32_CLOCK(APB1, 10)>,
		 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
};

stm32_lp_tick_source: &lptim1 {
	status = "okay";
	clocks = <&rcc STM32_CLOCK(APB1, 31)>,
		 <&rcc STM32_SRC_LSI LPTIM1_SEL(2)>;
};

&iwdg {
	status = "disabled";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(56)>;
			read-only;
		};

		slot0_partition: partition@e000 {
			label = "image-0";
			reg = <0x0000e000 DT_SIZE_K(452)>;
		};

		/* 4KiB of storage at the end of the 512KiB FLASH */
		storage_partition: partition@7f000 {
			label = "storage";
			reg = <0x0007f000 DT_SIZE_K(4)>;
		};
	};
};

/* W25Q128JVS, 128 Mbit NOR on QUADSPI1 bank 1. */
&quadspi {
	pinctrl-0 = <&quadspi1_clk_pe10 &quadspi1_bk1_ncs_pe11
		     &quadspi1_bk1_io0_pe12 &quadspi1_bk1_io1_pe13
		     &quadspi1_bk1_io2_pe14 &quadspi1_bk1_io3_pe15>;
	pinctrl-names = "default";
	status = "okay";

	nor_flash: qspi-nor-flash@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(128)>; /* 128 Mbit */
		qspi-max-frequency = <50000000>;
		spi-bus-width = <4>;
		writeoc = "PP_1_1_4";
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			slot1_partition: partition@0 {
				label = "image-1";
				reg = <0x00000000 DT_SIZE_K(452)>;
			};

			/* One swap chunk at a time. 64KiB keeps a 452KiB swap to 8
			 * passes, and spreads the wear. */
			scratch_partition: partition@71000 {
				label = "image-scratch";
				reg = <0x00071000 DT_SIZE_K(64)>;
			};

			/* Boot record for the OTA session. */
			fota_record_partition: partition@81000 {
				label = "fota-record";
				reg = <0x00081000 DT_SIZE_K(4)>;
			};
		};
	};
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_sda_pa8 &i2c2_scl_pa9>;
	pinctrl-names = "default";

	tmp1075: tmp1075@48 {
		compatible = "ti,tmp1075";
		friendly-name = "texas_temperature_tmp1075";
		reg = <0x48>;
		conversion-rate = <220000>;
		lower-threshold = <27>;
		upper-threshold = <28>;
		consecutive-fault-measurements = <4>;
	};

	atecc: atecc@60 {
		compatible = "atmel,atecc508a";
		reg = <0x60>;
		status = "okay";
	};

	ds3231: ds3231@68 {
		compatible = "maxim,ds3231-mfd";
		reg = <0x68>;
		status = "okay";

		ds3231_sensor: ds3231_sensor {
			compatible = "maxim,ds3231-sensor";
			status = "okay";
		};

		ds3231_rtc: ds3231_rtc {
			compatible = "maxim,ds3231-rtc";
			status = "okay";
			isw-gpios = <&gpioc 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};
};

/* MicroSD over SPI1, CS on PA4 as a GPIO. */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_miso_pa6 &spi1_mosi_pa7 &spi1_sck_pa5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
	clock-frequency = <1000000>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <1000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			status = "okay";
			disk-name = "SD";
		};
	};
};

usart_console: &usart3 {
	status = "okay";
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

&fdcan1 {
	status = "okay";
	bitrate = <1000000>;
	/** Using PLLQ as the clock source for FDCAN1,
	* We can set the clock divider to 12 to achieve a 4MHz clock for the time quanta.
	*/
	clocks = <&rcc STM32_CLOCK(APB1, 25)>, <&rcc STM32_SRC_PLL_Q FDCAN_SEL(1)>;
	pinctrl-0 = <&fdcan1_rx_pa11 &fdcan1_tx_pa12>;
	pinctrl-names = "default";
	//! Clock divider shouldn't be set for any other fdcan instance than fdcan1, as all other instances will use the same clock source as fdcan1, and the divider will be applied to all of them.
	// No divider is set, time quanta will be se to 48MHz as the clock source is PLLQ, which is 48MHz. This will result in a time quanta of 1/48MHz = 20.833ns, which is the minimum time quanta for FDCAN.
	clk-divider= <1>;
	sample-point = <875>;

};

&fdcan3 {
	status = "okay";
	bitrate = <1000000>;
	/** PLLQ at 48MHz is the FDCAN kernel clock, giving a 20.833ns time quantum.
	*/
	clocks = <&rcc STM32_CLOCK(APB1, 25)>, <&rcc STM32_SRC_PLL_Q FDCAN_SEL(1)>;
	pinctrl-0 = <&fdcan3_rx_pb3 &fdcan3_tx_pb4>;
	pinctrl-names = "default";
	//! Clock divider shouldn't be set for any other fdcan instance than fdcan1, as all other instances will use the same clock source as fdcan1, and the divider will be applied to all of them.
	/** clk-divider= <1>; */
	sample-point-data = <875>;

};

usart_rs485: &usart2 {
	status = "okay";
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <9600>;
	rs485: rs485 {
		status = "okay";
		compatible = "zephyr,modbus-serial";
		de-gpios = <&gpiof 9 GPIO_ACTIVE_HIGH>;
	};

};
